# =============================================================================

# ─── Projekto informacija ─────────────────────────────────────────────────────
PROJECT_NAME           = "Studentas projektas"
PROJECT_NUMBER         = 1.2
PROJECT_BRIEF          = "Studentų duomenų valdymo sistema su Rule of Five klasėmis"
OUTPUT_DIRECTORY       = docs

# ─── Įvesties failai ─────────────────────────────────────────────────────────
INPUT                  = .
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = NO
EXCLUDE                = docs build

# ─── Išvesties formatai ───────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
HTML_OUTPUT            = html
LATEX_OUTPUT           = latex

# ─── HTML išvaizda ───────────────────────────────────────────────────────────
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# ─── LaTeX / PDF nustatymai ───────────────────────────────────────────────────
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_BATCHMODE        = YES

# ─── Ekstrakcijos nustatymai ──────────────────────────────────────────────────
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ─── Grafai (reikia Graphviz / dot) ──────────────────────────────────────────
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# ─── Kiti nustatymai ─────────────────────────────────────────────────────────
OPTIMIZE_OUTPUT_FOR_C  = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             =
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
